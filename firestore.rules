rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for all unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // User profile and private store collections
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // Folders
      match /folders/{folderId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(folderId);
      }

      // Customers
      match /customers/{customerId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(customerId);
      }

      // Products (Inventory)
      match /products/{productId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(productId);
      }

      // Invoices / Debts / Sales
      match /invoices/{invoiceId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(invoiceId);
      }

      // Payments / Receipts
      match /payments/{paymentId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(paymentId);
      }

      // Customer Change Logs
      match /changeLogs/{logId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(logId);
      }

      // Settings
      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(settingId);
      }

      // Backups
      match /backups/{backupId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(backupId);
      }

      // FCM Tokens
      match /tokens/{tokenId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(tokenId);
      }

      // Profile details
      match /profile/{profileId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(profileId);
      }

      // Sessions / Devices
      match /sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isValidId(sessionId);
      }

      // Fallback for any other user-owned document or subcollection
      match /{allSubpaths=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}

